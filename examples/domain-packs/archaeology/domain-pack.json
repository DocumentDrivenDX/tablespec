    {
      "id": "cycle",
      "question": "Keep contradictory stratigraphic assertions visible",
      "sql": "SELECT a.id,b.id FROM stratigraphic_assertions a JOIN stratigraphic_assertions b ON a.source_context_id=b.target_context_id AND a.target_context_id=b.source_context_id WHERE a.id<b.id",
      "expected": [
        [
          "ST1",
          "ST2"
        ]
      ]
    },
    {
      "id": "dating",
      "question": "Overlapping interpretations keep both authors and evidence",
      "sql": "SELECT a.author,b.author FROM interpretations a JOIN interpretations b ON a.context_id=b.context_id AND a.id<b.id WHERE a.earliest<=b.latest AND b.earliest<=a.latest",
      "expected": [
        [
          "Author A",
          "Author B"
        ]
      ]
    },
    {
      "id": "media",
      "question": "One square drawing depicts two contexts",
      "sql": "SELECT asset_id,COUNT(DISTINCT context_id) FROM asset_subjects GROUP BY asset_id HAVING COUNT(DISTINCT context_id)>1",
      "expected": [
        [
          "AS4",
          2
        ]
      ]
    },
    {
