      "id": "specialists",
      "question": "NISP, MNI, sherds and vessels keep distinct denominators",
      "sql": "SELECT f.nisp,f.mni,p.sherd_count,p.estimated_vessels FROM fauna_results f JOIN analyses a ON a.id=f.analysis_id JOIN samples s ON s.id=a.sample_id JOIN find_lots l ON l.context_id=s.context_id JOIN objects o ON o.lot_id=l.id JOIN pottery_results p ON p.object_id=o.id",
      "expected": [
        [
          5,
          2,
          3,
          1
        ]
      ]
    },
    {
      "id": "lineage",
      "question": "Find-to-context chain is retained",
      "sql": "SELECT o.id,c.native_locus FROM objects o JOIN find_lots l ON l.id=o.lot_id JOIN contexts c ON c.id=l.context_id",
      "expected": [
        [
          "O1",
          "1"
        ]
      ]
    },
    {
      "id": "evidence-links",
      "question": "Interpretations retain resolved specialist evidence alongside native source literals",
      "sql": "SELECT i.author,p.form,f.taxon FROM interpretations i JOIN interpretation_evidence e ON e.interpretation_id=i.id LEFT JOIN pottery_results p ON p.id=e.pottery_result_id LEFT JOIN fauna_results f ON f.id=e.fauna_result_id ORDER BY i.id",
      "expected": [
        [
          "Author A",
          "bowl",
          null
        ],
        [
          "Author B",
          null,
          "synthetic-ungulate"
        ]
      ]
