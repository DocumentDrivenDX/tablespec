  "scenario_checks": [
    {
      "id": "two-applications",
      "question": "Two applications yield one offer and employment relationship",
      "sql": "SELECT c.id,COUNT(DISTINCT a.id),COUNT(DISTINCT o.id),COUNT(DISTINCT e.id) FROM candidates c JOIN applications a ON a.candidate_id=c.id LEFT JOIN offers o ON o.application_id=a.id LEFT JOIN employment_relationships e ON e.candidate_id=c.id GROUP BY c.id",
      "expected": [
        [
          "C1",
          2,
          1,
          1
        ]
      ]
    },
    {
      "id": "historical",
      "question": "Reporting relation is excluded before its valid period",
      "sql": "SELECT id FROM reporting_relationships WHERE valid_from<='2026-03-01' AND valid_to>='2026-03-01'",
      "expected": []
    },
    {
      "id": "candidate",
      "question": "Accepted application does not replace employment identity",
      "sql": "SELECT a.id,e.id FROM applications a JOIN employment_relationships e ON e.candidate_id=a.candidate_id AND e.position_id=a.position_id",
      "expected": [
        [
          "A1",
          "E1"
        ]
      ]
    },
    {
      "id": "cycle",
      "question": "A self-management assertion remains a visible error",
      "sql": "SELECT id FROM reporting_relationships WHERE employee_id=manager_id",
      "expected": [
        [
          "RR1"
        ]
      ]
    }
  ],
