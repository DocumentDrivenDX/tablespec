  "scenario_checks": [
    {
      "id": "downstream-change",
      "question": "Delay and RFI retain approved downstream change",
      "sql": "SELECT w.status,x.status,d.name FROM work_packages w JOIN activities a ON a.work_package_id=w.id JOIN dependencies dep ON dep.predecessor_id=a.id JOIN activities b ON b.id=dep.successor_id JOIN work_packages d ON d.id=b.work_package_id JOIN change_orders x ON x.downstream_package_id=d.id JOIN rfis r ON r.id=x.rfi_id WHERE w.status='delayed' AND x.status='approved'",
      "expected": [
        [
          "delayed",
          "approved",
          "Finish"
        ]
      ]
    },
    {
      "id": "bim-submittal",
      "question": "Approved submittal identifies model revision and physical asset",
      "sql": "SELECT s.status,s.revision,b.model_revision,b.native_object_id FROM submittals s JOIN bim_references b ON b.asset_id=s.asset_id",
      "expected": [
        [
          "approved",
          "r1",
          "r1",
          "beam-001"
        ]
      ]
    },
    {
      "id": "cycle",
      "question": "Expose directed schedule cycle without deleting dependency",
      "sql": "SELECT a.id,b.id FROM dependencies a JOIN dependencies b ON a.predecessor_id=b.successor_id AND a.successor_id=b.predecessor_id WHERE a.id<b.id",
      "expected": [
        [
          "D1",
          "D2"
        ]
      ]
    },
    {
      "id": "change",
      "question": "Proposed change stays separate from contract baseline",
      "sql": "SELECT c.amount,x.amount,x.status FROM contracts c JOIN change_orders x ON x.contract_id=c.id ORDER BY x.id",
      "expected": [
        [
          1000,
          50,
          "proposed"
        ],
        [
          1000,
          75,
          "approved"
        ]
      ]
    },
    {
      "id": "evidence",
      "question": "Inspection and RFI refer to same physical asset",
      "sql": "SELECT i.asset_id,r.status FROM inspections i JOIN rfis r ON r.asset_id=i.asset_id",
      "expected": [
        [
          "A1",
          "open"
        ]
      ]
    }
  ],
