  "scenario_checks": [
    {
      "id": "partial-return",
      "question": "Partial shipment and return preserve remaining inventory",
      "sql": "SELECT f.quantity,r.quantity,l.quantity-f.quantity+r.quantity FROM order_lines l JOIN fulfillments f ON f.line_id=l.id JOIN returns r ON r.line_id=l.id WHERE f.quantity<l.quantity",
      "expected": [
        [
          6,
          2,
          6
        ]
      ]
    },
    {
      "id": "fulfillment",
      "question": "Find over-fulfilled lines without repairing source quantities",
      "sql": "SELECT f.id FROM fulfillments f JOIN order_lines l ON f.line_id=l.id WHERE f.quantity>l.quantity ORDER BY f.id",
      "expected": [
        [
          "F2"
        ]
      ]
    },
    {
      "id": "settlement",
      "question": "Compare exact payment, invoice and refund amounts",
      "sql": "SELECT p.id FROM payments p JOIN invoices i ON p.invoice_id=i.id WHERE p.amount=i.amount AND p.currency=i.currency",
      "expected": [
        [
          "PAY1"
        ]
      ]
    },
    {
      "id": "refund",
      "question": "Return and refund use the original product price",
      "sql": "SELECT r.id FROM refunds r JOIN returns x ON x.id=r.return_id JOIN order_lines l ON l.id=x.line_id JOIN products p ON p.id=l.product_id WHERE r.amount=x.quantity*p.unit_price",
      "expected": [
        [
          "RF1"
        ]
      ]
    }
  ],
