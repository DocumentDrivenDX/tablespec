  "scenario_checks": [
    {
      "id": "replacement-gap",
      "question": "A 30-day series retains meter replacement and outage-labeled gaps",
      "sql": "SELECT m.name,g.reason,r.event_time FROM interval_gaps g JOIN interval_readings r ON r.id=g.reading_id JOIN channels c ON c.id=r.channel_id JOIN meters m ON m.id=c.meter_id JOIN outages o ON o.id=g.outage_id WHERE r.value IS NULL AND r.event_time>=m.valid_from AND r.event_time<=m.valid_to",
      "expected": [
        [
          "Replacement meter",
          "outage",
          "2026-01-20T10:00Z"
        ]
      ]
    },
    {
      "id": "reset",
      "question": "Cumulative register decrease is exposed",
      "sql": "SELECT b.id FROM interval_readings a JOIN interval_readings b ON a.channel_id=b.channel_id AND a.event_time<b.event_time WHERE b.value<a.value AND a.id='R1' AND b.id='R2'",
      "expected": [
        [
          "R2"
        ]
      ]
    },
    {
      "id": "unit",
      "question": "Cumulative reading kind and energy unit remain explicit",
      "sql": "SELECT DISTINCT reading_kind,unit FROM channels",
      "expected": [
        [
          "cumulative",
          "kW.h"
        ]
      ]
    },
    {
      "id": "topology",
      "question": "Feeder retains parent asset and outage",
      "sql": "SELECT a.id,a.parent_id,o.id FROM utility_assets a JOIN outages o ON o.asset_id=a.id",
      "expected": [
        [
          "A2",
          "A1",
          "O1"
        ]
      ]
    }
  ],
