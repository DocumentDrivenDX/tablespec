  "scenario_checks": [
    {
      "id": "split-excursion",
      "question": "A split lot reaches two shipments and exposes temperature excursion",
      "sql": "SELECT l.lot_code,COUNT(DISTINCT s.id) FROM lots l JOIN items i ON i.lot_id=l.id JOIN shipment_items x ON x.item_id=i.id JOIN shipments s ON s.id=x.shipment_id GROUP BY l.lot_code",
      "expected": [
        [
          "LOT1",
          2
        ]
      ]
    },
    {
      "id": "excursion",
      "question": "Compare temperature against explicit upper limit",
      "sql": "SELECT id,value,unit FROM sensor_readings WHERE value>upper_limit",
      "expected": [
        [
          "M2",
          17,
          "Cel"
        ]
      ]
    },
    {
      "id": "replay",
      "question": "Expose duplicate upstream event identity",
      "sql": "SELECT upstream_event_id,COUNT(*) FROM events GROUP BY upstream_event_id HAVING COUNT(*)>1",
      "expected": [
        [
          "SOURCE1",
          2
        ]
      ]
    },
    {
      "id": "lineage",
      "question": "Trace serialized item through lot and nested container",
      "sql": "SELECT i.serial,l.lot_code,p.sku,c.parent_id FROM items i JOIN lots l ON l.id=i.lot_id JOIN products p ON p.id=l.product_id JOIN containment a ON a.item_id=i.id JOIN containers c ON c.id=a.container_id",
      "expected": [
        [
          "SER1",
          "LOT1",
          "SKU1",
          "C1"
        ],
        [
          "SER2",
          "LOT1",
          "SKU1",
          null
        ]
      ]
    },
    {
      "id": "sensor",
      "question": "Keep method and temperature unit with measurements",
      "sql": "SELECT DISTINCT unit,method FROM sensor_readings",
      "expected": [
        [
          "Cel",
          "probe"
        ]
      ]
    }
  ],
