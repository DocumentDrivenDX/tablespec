  "scenario_checks": [
    {
      "id": "active-service",
      "question": "Canceled date does not cancel another service day",
      "sql": "SELECT t.id,t.service_date FROM trips t LEFT JOIN calendar_exceptions x ON x.calendar_id=t.calendar_id AND x.service_date=t.service_date AND x.exception_type='removed' WHERE x.id IS NULL",
      "expected": [
        [
          "T1",
          "2026-01-09"
        ]
      ]
    },
    {
      "id": "service-day",
      "question": "Delayed post-midnight arrival retains original service date",
      "sql": "SELECT t.service_date,s.arrival,o.observed_at,o.delay_seconds FROM trips t JOIN stop_times s ON s.trip_id=t.id JOIN realtime_observations o ON o.trip_id=t.id",
      "expected": [
        [
          "2026-01-09",
          "25:10:00",
          "2026-01-10T01:12:00-05:00",
          120
        ]
      ]
    },
    {
      "id": "cancellation",
      "question": "Canceled service date is not active",
      "sql": "SELECT t.id,x.service_date FROM trips t JOIN calendar_exceptions x ON x.calendar_id=t.calendar_id AND x.service_date=t.service_date WHERE x.exception_type='removed'",
      "expected": [
        [
          "T2",
          "2026-01-02"
        ]
      ]
    },
    {
      "id": "extended-time",
      "question": "Service-day times beyond midnight retain native spelling",
      "sql": "SELECT arrival FROM stop_times",
      "expected": [
        [
          "25:10:00"
        ]
      ]
    },
    {
      "id": "realtime",
      "question": "Observed delay is distinct from scheduled time",
      "sql": "SELECT delay_seconds FROM realtime_observations",
      "expected": [
        [
          120
        ]
      ]
    }
  ],
