  "scenario_checks": [
    {
      "id": "listing-history",
      "question": "Sequential listings and price change retain one property",
      "sql": "SELECT a.property_id,e.previous_price,e.price FROM listings a JOIN listings b ON b.property_id=a.property_id AND a.valid_to<b.valid_from JOIN listing_events e ON e.listing_id=a.id WHERE e.status='price-change'",
      "expected": [
        [
          "PR1",
          100000,
          95000
        ]
      ]
    },
    {
      "id": "operations",
      "question": "Brokerage, listing media and unit maintenance retain actual identities",
      "sql": "SELECT a.native_member_id,o.name,m.availability,r.status FROM listing_agents x JOIN agents a ON a.id=x.agent_id JOIN offices o ON o.id=a.office_id JOIN listings l ON l.id=x.listing_id JOIN media m ON m.property_id=l.property_id JOIN buildings b ON b.property_id=l.property_id JOIN units u ON u.building_id=b.id JOIN maintenance_requests r ON r.unit_id=u.id WHERE l.status='withdrawn'",
      "expected": [
        [
          "MEMBER1",
          "Synthetic brokerage",
          "external",
          "open"
        ]
      ]
    },
    {
      "id": "withdrawn",
      "question": "Withdrawn listing has no inferred sale",
      "sql": "SELECT l.id FROM listings l LEFT JOIN transactions t ON t.listing_id=l.id WHERE l.status='withdrawn' AND t.id IS NULL",
      "expected": [
        [
          "L1"
        ]
      ]
    },
    {
      "id": "distinction",
      "question": "Parcel, property, building and unit retain distinct identities",
      "sql": "SELECT p.id,pr.id,b.id,u.id FROM parcels p JOIN properties pr ON pr.parcel_id=p.id JOIN buildings b ON b.property_id=pr.id JOIN units u ON u.building_id=b.id",
      "expected": [
        [
          "PA1",
          "PR1",
          "B1",
          "U1"
        ]
      ]
    },
    {
      "id": "valuation",
      "question": "Valuation does not become transaction price",
      "sql": "SELECT v.amount,t.amount FROM valuations v JOIN listings l ON l.property_id=v.property_id JOIN transactions t ON t.listing_id=l.id",
      "expected": [
        [
          110000,
          100000
        ]
      ]
    }
  ],
