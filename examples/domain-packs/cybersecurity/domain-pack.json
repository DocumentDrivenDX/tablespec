  "scenario_checks": [
    {
      "id": "failed-then-success",
      "question": "Five failures precede success from another device",
      "sql": "SELECT COUNT(*),s.device_id FROM authentication_events f JOIN sessions fs ON fs.id=f.session_id JOIN authentication_events e ON e.outcome='success' JOIN sessions s ON s.id=e.session_id WHERE f.outcome='failure' AND f.event_time<e.event_time AND fs.device_id<>s.device_id GROUP BY s.device_id",
      "expected": [
        [
          5,
          "D2"
        ]
      ]
    },
    {
      "id": "collision",
      "question": "Same native device ID remains two publisher-qualified identities",
      "sql": "SELECT native_id,COUNT(DISTINCT publisher) FROM devices GROUP BY native_id",
      "expected": [
        [
          "device",
          2
        ]
      ]
    },
    {
      "id": "evidence",
      "question": "Trace finding to account and failure evidence",
      "sql": "SELECT f.id,a.id,e.outcome FROM findings f JOIN authentication_events e ON e.id=f.evidence_id JOIN sessions s ON s.id=e.session_id JOIN accounts a ON a.id=s.account_id",
      "expected": [
        [
          "F1",
          "A1",
          "failure"
        ]
      ]
    },
    {
      "id": "association",
      "question": "Event-to-incident link is attributable data",
      "sql": "SELECT event_id,incident_id FROM event_incident_links",
      "expected": [
        [
          "E1",
          "IN1"
        ]
      ]
    }
  ],
