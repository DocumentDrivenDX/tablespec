  "scenario_checks": [
    {
      "id": "last-touch",
      "question": "Attribution selects the latest eligible preceding touch",
      "sql": "SELECT a.id,t.id FROM attributions a JOIN conversions c ON c.id=a.conversion_id JOIN touchpoints t ON t.id=a.touchpoint_id JOIN attribution_rules r ON r.id=a.rule_id LEFT JOIN touchpoints x ON x.profile_id=c.profile_id AND x.event_day>t.event_day AND x.event_day<=c.event_day AND c.event_day-x.event_day<=r.window_days WHERE t.event_day<=c.event_day AND c.event_day-t.event_day<=r.window_days AND x.id IS NULL",
      "expected": [
        [
          "A1",
          "T2"
        ]
      ]
    },
    {
      "id": "withdrawal",
      "question": "Two campaign touches precede purpose withdrawal and later conversion",
      "sql": "SELECT p.id,COUNT(DISTINCT t.id),e.purpose,e.status FROM profiles p JOIN touchpoints t ON t.profile_id=p.id JOIN consents c ON c.profile_id=p.id JOIN consent_events e ON e.consent_id=c.id JOIN conversions v ON v.profile_id=p.id WHERE v.event_day>5 GROUP BY p.id,e.purpose,e.status",
      "expected": [
        [
          "P1",
          2,
          "campaign-email",
          "withdrawn"
        ]
      ]
    },
    {
      "id": "consent-origin",
      "question": "Consent purpose links to source identity, session and attributed merge evidence",
      "sql": "SELECT c.purpose,i.publisher,a.status FROM consents c JOIN source_identities i ON i.id=c.source_identity_id JOIN sessions s ON s.source_identity_id=i.id JOIN identity_assertions a ON a.left_id=i.id",
      "expected": [
        [
          "campaign-email",
          "channel-a",
          "asserted"
        ]
      ]
    },
    {
      "id": "window",
      "question": "Find conversions outside the selected window",
      "sql": "SELECT DISTINCT c.id FROM conversions c JOIN touchpoints t ON t.profile_id=c.profile_id JOIN attribution_rules r WHERE c.event_day-t.event_day>r.window_days",
      "expected": [
        [
          "CV2"
        ]
      ]
    },
    {
      "id": "unattributed",
      "question": "Outside-window conversion stays unattributed",
      "sql": "SELECT conversion_id FROM attributions WHERE touchpoint_id IS NULL",
      "expected": [
        [
          "CV2"
        ]
      ]
    },
    {
      "id": "consent",
      "question": "Consent includes channel and validity interval",
      "sql": "SELECT channel_id,status,valid_to FROM consents",
      "expected": [
        [
          "CH1",
          "granted",
          "2026-01-05"
        ]
      ]
    }
  ],
