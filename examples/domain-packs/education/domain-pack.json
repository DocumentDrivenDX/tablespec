  "scenario_checks": [
    {
      "id": "missing-result",
      "question": "An assessment without result remains missing",
      "sql": "SELECT a.id FROM enrollments e JOIN assessments a ON a.offering_id=e.offering_id LEFT JOIN results r ON r.enrollment_id=e.id AND r.assessment_id=a.id WHERE r.id IS NULL",
      "expected": [
        [
          "A3"
        ]
      ]
    },
    {
      "id": "offering",
      "question": "Expose a result for another offering",
      "sql": "SELECT r.id FROM results r JOIN enrollments e ON e.id=r.enrollment_id JOIN assessments a ON a.id=r.assessment_id WHERE e.offering_id<>a.offering_id",
      "expected": [
        [
          "R2"
        ]
      ]
    },
    {
      "id": "valid-result",
      "question": "The valid result stays attached to the right offering",
      "sql": "SELECT r.id FROM results r JOIN enrollments e ON e.id=r.enrollment_id JOIN assessments a ON a.id=r.assessment_id WHERE e.offering_id=a.offering_id",
      "expected": [
        [
          "R1"
        ]
      ]
    },
    {
      "id": "prerequisite",
      "question": "Self-prerequisite remains an explicit contradiction",
      "sql": "SELECT id FROM prerequisites WHERE course_id=prerequisite_id",
      "expected": [
        [
          "PR1"
        ]
      ]
    }
  ],
