  "scenario_checks": [
    {
      "id": "effort-event",
      "question": "Occurrence and sampling effort share actual survey event",
      "sql": "SELECT o.id FROM occurrences o JOIN effort e ON e.id=o.effort_id WHERE e.event_id<>o.event_id",
      "expected": []
    },
    {
      "id": "connected-measurements",
      "question": "Two connected reaches retain temperature and dissolved oxygen with probe methods",
      "sql": "SELECT p.name,COUNT(DISTINCT r.id) FROM observations o JOIN observed_properties p ON p.id=o.property_id JOIN samples s ON s.id=o.sample_id JOIN sampling_events e ON e.id=s.event_id JOIN monitoring_sites ms ON ms.id=e.site_id JOIN reaches r ON r.id=ms.reach_id JOIN methods m ON m.id=e.method_id WHERE p.name IN ('temperature','dissolved-oxygen') AND m.fraction='in-situ' GROUP BY p.name ORDER BY p.name",
      "expected": [
        [
          "dissolved-oxygen",
          2
        ],
        [
          "temperature",
          2
        ]
      ]
    },
    {
      "id": "censor",
      "question": "Below-detection nitrate is not zero",
      "sql": "SELECT id,threshold,qualifier FROM observations WHERE result_kind='censored' AND value IS NULL",
      "expected": [
        [
          "O2",
          0.1,
          "below-detection"
        ]
      ]
    },
    {
      "id": "match",
      "question": "Coordinate-only match stays unresolved",
      "sql": "SELECT id FROM site_matches WHERE resolution='unresolved'",
      "expected": [
        [
          "SM1"
        ]
      ]
    },
    {
      "id": "effort",
      "question": "Exclude effort-unknown detection from quantitative comparison",
      "sql": "SELECT o.id FROM occurrences o JOIN effort e ON e.id=o.effort_id WHERE e.amount IS NULL",
      "expected": [
        [
          "OC3"
        ]
      ]
    },
    {
      "id": "zero",
      "question": "Known-effort non-detection is distinct from missing occurrence",
      "sql": "SELECT o.id FROM occurrences o JOIN effort e ON e.id=o.effort_id WHERE o.count=0 AND o.detection='not-detected' AND e.amount IS NOT NULL",
      "expected": [
        [
          "OC2"
        ]
      ]
    },
    {
      "id": "network",
      "question": "Reach linkage preserves upstream direction",
      "sql": "SELECT upstream_id,downstream_id FROM network_links",
      "expected": [
        [
          "R1",
          "R2"
        ]
      ]
    },
    {
      "id": "comparability",
      "question": "Matrix, fraction and taxonomy rank are retained",
      "sql": "SELECT DISTINCT m.matrix,m.fraction,t.rank FROM occurrences o JOIN sampling_events e ON e.id=o.event_id JOIN methods m ON m.id=e.method_id JOIN identifications i ON i.id=o.identification_id JOIN taxa t ON t.id=i.taxon_id",
      "expected": [
        [
          "benthos",
          "whole",
          "family"
        ]
      ]
    },
    {
      "id": "fishing",
      "question": "Catch effort does not become scientific survey effort",
      "sql": "SELECT effort_unit FROM fishing_events",
