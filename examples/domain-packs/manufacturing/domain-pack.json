  "scenario_checks": [
    {
      "id": "resume",
      "question": "Temperature alarm precedes maintenance and resumed run",
      "sql": "SELECT a.condition,m.action,r.id FROM alarms a JOIN observations o ON o.id=a.observation_id JOIN maintenance_events m ON m.alarm_id=a.id JOIN production_runs r ON r.id=m.resumed_run_id WHERE o.observed_at<m.occurred_at AND m.occurred_at<r.started_at",
      "expected": [
        [
          "high-temperature",
          "replace",
          "R2"
        ]
      ]
    },
    {
      "id": "unit-change",
      "question": "Do not concatenate unlabeled sensor units",
      "sql": "SELECT component_id,COUNT(DISTINCT unit) FROM observations GROUP BY component_id HAVING COUNT(DISTINCT unit)>1",
      "expected": [
        [
          "C2",
          2
        ]
      ]
    },
    {
      "id": "lineage",
      "question": "Trace run through work order and material lot",
      "sql": "SELECT r.id,l.material,w.status FROM production_runs r JOIN work_orders w ON w.id=r.work_order_id JOIN material_lots l ON l.id=r.lot_id",
      "expected": [
        [
          "R1",
          "steel",
          "complete"
        ],
        [
          "R2",
          "steel",
          "complete"
        ]
      ]
    },
    {
      "id": "maintenance",
      "question": "Replacement identifies the actual component",
      "sql": "SELECT c.name,m.action FROM maintenance_events m JOIN components c ON c.id=m.component_id",
      "expected": [
        [
          "Bearing",
          "replace"
        ]
      ]
    }
  ],
