  "scenario_checks": [
    {
      "id": "net-settlement",
      "question": "100.00 settlement less 25.00 return leaves 75.00",
      "sql": "SELECT s.amount,r.amount,s.amount-r.amount FROM settlements s JOIN returns r ON r.payment_id=s.payment_id AND r.currency='USD'",
      "expected": [
        [
          100,
          25,
          75
        ]
      ]
    },
    {
      "id": "balance",
      "question": "Find unbalanced journals without rounding into balance",
      "sql": "SELECT journal FROM ledger_entries GROUP BY journal,currency HAVING SUM(CASE WHEN side='debit' THEN amount ELSE -amount END)<>0 ORDER BY journal",
      "expected": [
        [
          "J2"
        ]
      ]
    },
    {
      "id": "settled",
      "question": "A status event is distinct from settlement evidence",
      "sql": "SELECT p.id,e.status,s.amount FROM payment_instructions p JOIN status_events e ON e.payment_id=p.id JOIN settlements s ON s.payment_id=p.id",
      "expected": [
        [
          "PI1",
          "accepted",
          100
        ]
      ]
    },
    {
      "id": "currency",
      "question": "Journal amounts remain qualified by currency",
      "sql": "SELECT DISTINCT currency FROM ledger_entries",
      "expected": [
        [
          "USD"
        ]
      ]
    }
  ],
