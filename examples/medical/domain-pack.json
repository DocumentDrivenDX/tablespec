    "fhir_resource_key": {
      "description": "ResourceType/native-id, scoped to the pinned HL7 R4 corpus"
    },
    "fhir_temporal_literal": {
      "description": "Original FHIR temporal spelling, including partial dates and timezone offsets"
    },
    "exact_decimal_text": {
      "description": "Source decimal spelling retained without binary-number coercion"
    }
  },
